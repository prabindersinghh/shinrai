# Copy to .env (repo root or backend/). Everything is optional: without keys Shinrai runs on SEED/CACHED data.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
DATA_GOV_IN_KEY=                # blank = data.gov.in public sample key (rate-limited)
GST_PROVIDER=none               # none | cashfree | surepass
GST_API_KEY=                    # cashfree: "client_id:client_secret"
DIRECTOR_PROVIDER=none          # none | probe42
DIRECTOR_API_KEY=
ADAPTER_MODE_DEFAULT=auto
THEATER_DELAY_MS=120
NODE_DELAY_MS=150
EDGE_DELAY_MS=70
DRAMA_DELAY_MS=650
FRONTEND_URL=http://localhost:5173

# Ground truth / 3D
GOOGLE_MAPS_KEY=                # Geocoding, Static Maps, Photorealistic 3D Tiles
CESIUM_ION_TOKEN=               # optional fallback for 3D terrain
EE_PROJECT=                     # Google Earth Engine cloud project id
EE_SERVICE_ACCOUNT_JSON=        # path to service-account JSON, or run `earthengine authenticate`
NOMINATIM_USER_AGENT=shinrai-hackathon
GROUND_BUFFER_M=150
